# ====================================================================
# MIT-WPU DoCSA Placements Portal - Environment Variables
# ====================================================================

# GitHub Integration (For Direct "Commit to GitHub" & Vercel Auto-deploy)
# On Vercel: Add these under Project Settings > Environment Variables
GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere
GITHUB_OWNER=yadnyesh2018
GITHUB_REPO=mit-wpu-docsa-placements
GITHUB_BRANCH=main

# Security PIN for Authorizing Edits & Saves
# On Vercel: Set under Project Settings > Environment Variables
# Anyone attempting to save will be prompted to enter this PIN
SECURITY_PIN=1234

# Client-Side Fallback (Optional, for static-only hosting without serverless)
VITE_GITHUB_TOKEN=
VITE_GITHUB_OWNER=
VITE_GITHUB_REPO=
VITE_GITHUB_BRANCH=main
VITE_SECURITY_PIN=1234
